NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Built-in website CMS at /admin. Use a unique password (12+ characters) and secret (32+).
# Never expose these through NEXT_PUBLIC_ variables.
# Administrator email defaults to the address below; override it for another account.
SEKIBAT_ADMIN_EMAIL=test@sekibat.com
# SEKIBAT_ADMIN_PASSWORD=
# SEKIBAT_ADMIN_SECRET=
# Optional absolute directory on a persistent disk. Defaults to .cms in the app directory.
# SEKIBAT_CMS_DIR=

# Set these when the Sekibat backend is available. Leaving SEKIBAT_API_URL unset keeps the
# frontend on its bundled placeholder records and local enquiry preview.
# SEKIBAT_API_URL=https://api.example.com/v1
# SEKIBAT_API_KEY=

# Shared only between the backend/CMS and POST /api/revalidate on this frontend.
# Generate a long random value for every environment.
# SEKIBAT_REVALIDATE_SECRET=
