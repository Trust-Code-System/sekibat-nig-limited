NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Docker development database only. Replace both matching password placeholders.
# Use a URL-safe password (for example, hexadecimal).
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://sekibat:replace-with-local-password@127.0.0.1:5433/sekibat
# On Vercel set DATABASE_URL to the managed provider's pooled URL instead.
# POSTGRES_PASSWORD is only used by local Docker Compose.
DATABASE_POOL_MAX=3
